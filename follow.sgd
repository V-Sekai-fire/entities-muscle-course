## The skinned avatar's bones follow the muscle skeleton. Mapping as data plus arithmetic: the host
## hands over the tables once (`setup`) and then one array of body placements per pose (`pose`).
##
## Frames. The muscle skeleton is in MuJoCo's axes (Z up, faces +X, left is +Y). The avatar is in the
## engine's (Y up, faces +Z, left is +X). A MuJoCo vector (x, y, z) is the engine's (y, z, x), and a
## MuJoCo quaternion (w; x, y, z) is the engine's (w; y, z, x). `_at` and `_turn` are the only places
## that know this.
##
## For an avatar bone c driven by body b, the bone's orientation in the skeleton's space is
##   W_c = D_b * A_c * R_c
## R_c is the bone's rest orientation, D_b = turn_b(pose) * turn_b(default pose)^-1 is how far the
## body has turned from the muscle skeleton's default pose, and A_c is the smallest rotation that
## takes the avatar's rest direction (head of `from` to head of `to`) onto the muscle skeleton's
## default direction (origin of `from` to origin of `to`), or no rotation when the row names no pair.
## A bone no row drives keeps its rest orientation against its parent. Only orientations are set:
## every bone keeps its rest offset from its parent, so the avatar keeps its own bone lengths.
## The root bone is then moved so the midpoint of the two hip joints lands on the muscle skeleton's.
##
## Chosen from tests/math_proof.gd: Quaternion and Vector3 values and their operators exist in the
## guest and give the host's own numbers, at the cost of float arithmetic, so the tables are kept as
## Arrays of them.

const ROW: int = 6
const PLACE: int = 7

var ready: bool = false
var parent: PackedInt32Array = PackedInt32Array()
var driver: PackedInt32Array = PackedInt32Array()
var pre: Array = []
var offset: Array = []
var zero_inv: Array = []
var body_count: int = 0
var hip_a: int = -1
var hip_b: int = -1
var femur_a: int = -1
var femur_b: int = -1


func _at(t: PackedFloat64Array, o: int) -> Vector3:
	return Vector3(t[o + 1], t[o + 2], t[o])


func _turn(t: PackedFloat64Array, o: int) -> Quaternion:
	return Quaternion(t[o + 5], t[o + 6], t[o + 4], t[o + 3])


## Tables, once. Returns 0, or a negative number naming what was refused.
##   parents  one per bone; bone 0 is the only root (-1) and a parent comes before its children
##   rest     7 per bone: head x, y, z and orientation x, y, z, w, in the skeleton's space at rest
##   drive    6 per row: bone, body, bone from, bone to, body from, body to; the pair is -1 when absent
##   zero     7 per body, as the physics guest gives them at its default pose: x, y, z, w, x, y, z
##   hips     the two bones whose heads are the avatar's hip joints, then the two bodies whose
##            origins are the muscle skeleton's
func setup(parents: PackedInt32Array, rest: PackedFloat64Array, drive: PackedInt32Array, zero: PackedFloat64Array, hips: PackedInt32Array) -> int:
	ready = false
	var n: int = parents.size()
	var m: int = zero.size() / PLACE
	if n == 0 or rest.size() != n * PLACE:
		return -1
	if m == 0 or zero.size() != m * PLACE:
		return -2
	if drive.size() % ROW != 0 or hips.size() != 4:
		return -3
	if hips[0] < 0 or hips[0] >= n or hips[1] < 0 or hips[1] >= n or hips[2] < 0 or hips[2] >= m or hips[3] < 0 or hips[3] >= m:
		return -4
	var head: Array = []
	var rot: Array = []
	for c in n:
		var o: int = c * PLACE
		if parents[c] >= c or (c == 0) != (parents[c] < 0):
			return -5
		head.append(Vector3(rest[o], rest[o + 1], rest[o + 2]))
		rot.append(Quaternion(rest[o + 3], rest[o + 4], rest[o + 5], rest[o + 6]))
	var new_pre: Array = []
	var new_offset: Array = []
	var new_driver: PackedInt32Array = PackedInt32Array()
	new_driver.resize(n)
	for c in n:
		var p: int = parents[c]
		new_driver[c] = -1
		if p < 0:
			new_pre.append(rot[c])
			new_offset.append(head[c])
		else:
			var inv: Quaternion = rot[p].inverse()
			var from_parent: Vector3 = head[c] - head[p]
			new_pre.append(inv * rot[c])
			new_offset.append(inv * from_parent)
	var new_zero: Array = []
	for b in m:
		new_zero.append(_turn(zero, b * PLACE).inverse())
	var rows: int = drive.size() / ROW
	for r in rows:
		var k: int = r * ROW
		var c: int = drive[k]
		var b: int = drive[k + 1]
		if c < 0 or c >= n or b < 0 or b >= m or new_driver[c] != -1:
			return -6
		new_driver[c] = b
		var bone_from: int = drive[k + 2]
		if bone_from < 0:
			new_pre[c] = rot[c]
		else:
			var bone_to: int = drive[k + 3]
			var body_from: int = drive[k + 4]
			var body_to: int = drive[k + 5]
			if bone_from >= n or bone_to < 0 or bone_to >= n or body_from < 0 or body_from >= m or body_to < 0 or body_to >= m:
				return -7
			var ours: Vector3 = head[bone_to] - head[bone_from]
			var theirs: Vector3 = _at(zero, body_to * PLACE) - _at(zero, body_from * PLACE)
			if ours.length() < 1e-9 or theirs.length() < 1e-9:
				return -8
			ours = ours.normalized()
			theirs = theirs.normalized()
			var cosine: float = ours.dot(theirs)
			if cosine < -0.999999:
				return -9
			var axis: Vector3 = ours.cross(theirs)
			var align: Quaternion = Quaternion(axis.x, axis.y, axis.z, 1.0 + cosine).normalized()
			new_pre[c] = align * rot[c]
	parent = parents
	driver = new_driver
	pre = new_pre
	offset = new_offset
	zero_inv = new_zero
	body_count = m
	hip_a = hips[0]
	hip_b = hips[1]
	femur_a = hips[2]
	femur_b = hips[3]
	ready = true
	return 0


## One pose. `bodies` is 7 per body as the physics guest gives them: x, y, z, w, x, y, z.
## Returns 4 per bone, the bone's pose rotation against its parent as x, y, z, w, and then 3: the
## root bone's pose position. Returns an empty array before `setup` or for a wrong body count.
func pose(bodies: PackedFloat64Array) -> PackedFloat64Array:
	var out: PackedFloat64Array = PackedFloat64Array()
	if not ready or bodies.size() != body_count * PLACE:
		return out
	var n: int = parent.size()
	out.resize(n * 4 + 3)
	var world: Array = []
	var head: Array = []
	for c in n:
		var p: int = parent[c]
		var b: int = driver[c]
		var w: Quaternion = pre[c]
		if b >= 0:
			var delta: Quaternion = _turn(bodies, b * PLACE) * zero_inv[b]
			w = delta * w
		elif p >= 0:
			w = world[p] * w
		var local: Quaternion = w
		var at: Vector3 = offset[c]
		if p >= 0:
			var above: Quaternion = world[p]
			local = above.inverse() * w
			at = head[p] + above * at
		world.append(w)
		head.append(at)
		var o: int = c * 4
		out[o] = local.x
		out[o + 1] = local.y
		out[o + 2] = local.z
		out[o + 3] = local.w
	var ours: Vector3 = (head[hip_a] + head[hip_b]) * 0.5
	var theirs: Vector3 = (_at(bodies, femur_a * PLACE) + _at(bodies, femur_b * PLACE)) * 0.5
	var root_at: Vector3 = head[0] + theirs - ours
	out[n * 4] = root_at.x
	out[n * 4 + 1] = root_at.y
	out[n * 4 + 2] = root_at.z
	return out
